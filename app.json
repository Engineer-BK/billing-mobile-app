{
  "expo": {
    "name": "CounterPress",
    "slug": "counterpress",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/counter-press-app-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/counter-press-without-orange-background.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "android": {
      "package": "com.aftabrental.billingapp",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/counter-press-adaptive-foreground.png",
        "backgroundColor": "#FE8E46"
      },
      "splash": {
        "image": "./assets/counter-press-without-orange-background.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "0ba0093e-7fea-4fd6-8267-344a0939716f"
      }
    },
    "owner": "sahidexpos-team"
  }
}
