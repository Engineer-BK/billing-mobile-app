{
  "expo": {
    "name": "CounterPress",
    "slug": "billing-mobile-app",
    "owner": "basirexpos-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/counter-press-with-orange-background.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/counter-press-without-orange-background.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF",
      "dark": {
        "image": "./assets/counter-press-without-orange-background.png",
        "resizeMode": "contain",
        "backgroundColor": "#0A1322"
      }
    },
    "android": {
      "package": "com.aftabrental.billingapp",
      "versionCode": 1,
      "userInterfaceStyle": "automatic",
      "adaptiveIcon": {
        "foregroundImage": "./assets/counter-press-with-orange-background.png",
        "backgroundColor": "#ff944f"
      },
      "splash": {
        "image": "./assets/counter-press-without-orange-background.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF",
        "dark": {
          "image": "./assets/counter-press-without-orange-background.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A1322"
        }
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "d799a663-b1dc-48fd-9d51-66c81c912ea0"
      }
    }
  }
}
