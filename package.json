    "postinstall": "node scripts/patch-printer.js && jetify"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "@expo/vector-icons": "^14.0.3",
    "expo": "~51.0.38",
    "expo-build-properties": "~0.12.5",
    "expo-dev-client": "~4.0.28",
    "expo-font": "~12.0.10",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-bluetooth-escpos-printer": "^0.0.5",
    "react-native-web": "~0.19.10"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.79",
    "babel-preset-expo": "~11.0.15",
    "jetifier": "^2.0.0",
    "typescript": "~5.3.3"
  },
  "private": true
